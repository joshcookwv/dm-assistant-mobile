# Public client configuration. Real values belong in EAS environment variables
# or an ignored .env.local file, not in committed source.
EXPO_PUBLIC_AI_PROXY_BASE_URL=https://your-worker.example.workers.dev
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=

# Local UI/regression testing only. This is ignored in production builds.
EXPO_PUBLIC_DEBUG_PRO_ACCESS=false
