{
  "expo": {
    "name": "DM Assistant",
    "slug": "dm-assistant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dmassistantmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.infernalbulldog.dmassistant",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose map images to attach to your campaign."
      }
    },
    "android": {
      "package": "com.infernalbulldog.dmassistant",
      "adaptiveIcon": {
        "backgroundColor": "#16130f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16130f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose map images to attach to your campaign."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cfa7ca0-a278-4be8-b725-24444702ec5e"
      }
    }
  }
}
