# Copy to .env (Node adapter) or set as platform secrets (Cloudflare Workers /
# Vercel Edge — see README.md). Never commit the real values.

# Your own Anthropic API key, billed to you — NOT the same key format as a
# user's BYO key. This is what makes the Premium tier's AI "bundled."
ANTHROPIC_API_KEY=sk-ant-...

# RevenueCat project secret key (Project settings > API keys > Secret key).
# Used server-side to verify a caller's "premium" entitlement is active.
REVENUECAT_SECRET_KEY=sk_...

# Node adapter only.
PORT=8787
